{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-cycles.local/schemas/checkpoint-metadata-1.schema.json",
  "title": "Light Cycles checkpoint metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "checkpoint_id",
    "step",
    "model_architecture",
    "observation_schema",
    "action_schema",
    "onnx",
    "pytorch",
    "artifacts",
    "metadata_sha256"
  ],
  "properties": {
    "format": {
      "const": "lc-checkpoint/1"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/id"
    },
    "step": {
      "$ref": "#/$defs/safeInt"
    },
    "model_architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        }
      }
    },
    "observation_schema": {
      "const": "lc-observation/1"
    },
    "action_schema": {
      "const": "lc-action/1"
    },
    "onnx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "opset",
        "runtime"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "opset": {
          "$ref": "#/$defs/safeInt"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pytorch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "format"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "format": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "file",
          "sha256"
        ],
        "properties": {
          "format": {
            "enum": [
              "onnx",
              "pytorch"
            ]
          },
          "file": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "format": {
                "const": "onnx"
              }
            },
            "required": [
              "format"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "format": {
                "const": "pytorch"
              }
            },
            "required": [
              "format"
            ]
          }
        }
      ]
    },
    "metadata_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    }
  }
}
