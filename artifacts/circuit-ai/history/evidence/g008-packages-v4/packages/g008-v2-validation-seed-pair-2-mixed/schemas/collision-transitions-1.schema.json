{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-cycles.local/schemas/collision-transitions-1.schema.json",
  "title": "Light Cycles collision transition vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "action_order",
    "cases"
  ],
  "properties": {
    "format": {
      "const": "lc-collision-vectors/1"
    },
    "action_order": {
      "const": [
        "UP",
        "RIGHT",
        "DOWN",
        "LEFT"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "action": {
      "oneOf": [
        {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        {
          "const": "INVALID"
        }
      ]
    },
    "causes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "out_of_bounds",
            "occupied_trail",
            "occupied_head",
            "same_destination",
            "head_swap",
            "invalid_action",
            "reverse_action"
          ]
        }
      }
    },
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "width",
        "height",
        "positions",
        "headings",
        "actions",
        "expected_causes",
        "expected_result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "headings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "UP",
              "RIGHT",
              "DOWN",
              "LEFT"
            ]
          }
        },
        "occupied_cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "expected_causes": {
          "$ref": "#/$defs/causes"
        },
        "expected_result": {
          "enum": [
            "agent_0_win",
            "agent_1_win",
            "draw"
          ]
        }
      }
    }
  }
}
