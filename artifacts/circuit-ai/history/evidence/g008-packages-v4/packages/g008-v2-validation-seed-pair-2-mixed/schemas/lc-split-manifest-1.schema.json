{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://light-cycles.local/schemas/lc-split-manifest-1.schema.json",
  "title": "Frozen G008 train/validation/final split manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "frozen", "manifest_sha256", "seed_plan_sha256", "rows"],
  "properties": {
    "format": {"const": "lc-split-manifest/1"},
    "frozen": {"type": "boolean"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "seed_plan_sha256": {"$ref": "#/$defs/sha256"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split", "opponent_id", "opponent_sha256", "opponent_code_sha256",
        "opponent_config_sha256", "opponent_model_sha256",
        "target_checkpoint_sha256", "training_config_sha256", "source_id",
        "source_data_sha256", "seed", "arena_index", "game_index",
        "target_seat", "usages"
      ],
      "properties": {
        "split": {"enum": ["train", "imitation_demo", "validation", "final"]},
        "opponent_id": {"$ref": "#/$defs/id"},
        "opponent_sha256": {"$ref": "#/$defs/sha256"},
        "opponent_code_sha256": {"$ref": "#/$defs/sha256"},
        "opponent_config_sha256": {"$ref": "#/$defs/sha256"},
        "opponent_model_sha256": {"$ref": "#/$defs/sha256"},
        "target_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "training_config_sha256": {"$ref": "#/$defs/sha256"},
        "source_id": {"$ref": "#/$defs/id"},
        "source_data_sha256": {"$ref": "#/$defs/sha256"},
        "seed": {"type": "integer", "minimum": 0},
        "arena_index": {"type": "integer", "minimum": 0},
        "game_index": {"type": "integer", "minimum": 0},
        "target_seat": {"type": "integer", "enum": [0, 1]},
        "usages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["train", "imitation", "reward_design", "validation", "checkpoint_selection", "final_eval"]}
        }
      }
    }
  }
}
